# Example environment configuration for ubuntu-sshd
# Copy these into Railway's Variables (or use the RAW editor) and fill in the values.

# SSH username inside the container (defaults to "ubuntu" if not set)
SSH_USERNAME=ubuntu

# REQUIRED: password for the SSH user (set a strong, unique value)
SSH_PASSWORD=

# OPTIONAL: contents of your authorized_keys file
# If set, password authentication is disabled and only keys are allowed.
AUTHORIZED_KEYS=

# OPTIONAL: extra sshd configuration directives (one line or multiple lines)
SSHD_CONFIG_ADDITIONAL=

# OPTIONAL: path to an additional sshd_config file inside the container
SSHD_CONFIG_FILE=

# OPTIONAL: enable systemd as PID 1 inside the container ("1" or "true")
ENABLE_SYSTEMD=